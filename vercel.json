{
  "rewrites": [
    { "source": "/validation-key.txt", "destination": "/api/validation-key" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://*.pinet.com https://*.minepi.com" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
